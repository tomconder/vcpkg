diff --git a/CMakeLists.txt b/CMakeLists.txt
index b4b1f2f..09ac2cd 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -128,7 +128,18 @@ endif ()
 target_compile_definitions(${USEARCH_TARGET_NAME} INTERFACE "USEARCH_USE_OPENMP=$<BOOL:${USEARCH_USE_OPENMP}>")
 
 # Supplementary compilation settings affecting "index_plugins.hpp"
-target_compile_definitions(${USEARCH_TARGET_NAME} INTERFACE "USEARCH_USE_NUMKONG=$<BOOL:${USEARCH_USE_NUMKONG}>")
+set(USEARCH_USE_NUMKONG_SHARED OFF)
+if (USEARCH_USE_NUMKONG)
+    # `configure_with_numkong()` in index_plugins.hpp calls `nk_find_kernel_punned`, which is only declared
+    # when NK_DYNAMIC_DISPATCH=1, and only implemented in the shared `nk_shared` runtime-dispatch library.
+    find_package(unofficial-numkong CONFIG QUIET)
+    if (TARGET unofficial::numkong::nk_shared)
+        set(USEARCH_USE_NUMKONG_SHARED ON)
+        target_link_libraries(${USEARCH_TARGET_NAME} INTERFACE unofficial::numkong::nk_shared)
+        target_compile_definitions(${USEARCH_TARGET_NAME} INTERFACE "NK_DYNAMIC_DISPATCH=1")
+    endif ()
+endif ()
+target_compile_definitions(${USEARCH_TARGET_NAME} INTERFACE "USEARCH_USE_NUMKONG=$<BOOL:${USEARCH_USE_NUMKONG_SHARED}>")
 
